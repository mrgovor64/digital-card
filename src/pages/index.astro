---
import "../styles/global.css";
import Layout from "../components/Layout.astro";
import LocationIcon from "../components/icons/LocationIcon.astro";
import ContactIcon from "../components/icons/ContactIcon.astro";
import EmailIcon from "../components/icons/EmailIcon.astro";
import PhoneIcon from "../components/icons/PhoneIcon.astro";
import TelegramIcon from "../components/icons/TelegramIcon.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
import CopyIcon from "../components/icons/CopyIcon.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import LanguagesIcon from "../components/icons/LanguagesIcon.astro";
import LinkIcon from "../components/icons/LinkIcon.astro";
import FacebookIcon from "../components/icons/FacebookIcon.astro";
import LinkedInIcon from "../components/icons/LinkedInIcon.astro";
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import CertificationIcon from "../components/icons/CertificationIcon.astro";
import SpeakingIcon from "../components/icons/SpeakingIcon.astro";

const currentYear = new Date().getFullYear();

const contacts = [
  {
    label: "Email",
    value: "mrgovor64@gmail.com",
    href: "mailto:mrgovor64@gmail.com",
    copyValue: "mrgovor64@gmail.com",
    copyLabel: "email address",
    icon: EmailIcon,
  },
  {
    label: "Phone",
    value: "+52 33 3238 3664",
    href: "tel:+523332383664",
    copyValue: "+523332383664",
    copyLabel: "phone number",
    icon: PhoneIcon,
  },
  {
    label: "Telegram",
    value: "@mr_govor",
    href: "https://t.me/mr_govor",
    copyValue: "@mr_govor",
    copyLabel: "Telegram username",
    icon: TelegramIcon,
    external: true,
  },
  {
    label: "WhatsApp",
    value: "+52 33 3238 3664",
    href: "https://wa.me/523332383664",
    copyValue: "+523332383664",
    copyLabel: "WhatsApp number",
    icon: WhatsAppIcon,
    external: true,
  },
];

const certifications = [
  {
    name: "AWS Certified Security – Specialty",
    image: "/images/badges/aws-certified-security-specialty.png",
    href: "https://cp.certmetrics.com/amazon/en/public/verify/credential/1bd4d9a8ea7b40ba98f88c49c03f8d21",
    status: "Active",
    expired: false,
  },
  {
    name: "AWS Certified DevOps Engineer – Professional",
    image: "/images/badges/aws-devops-professional.png",
    href: "https://cp.certmetrics.com/amazon/en/public/verify/credential/16a2988039e84ce490a0c3ea7030ac08",
    status: "Active",
    expired: false,
  },
  {
    name: "AWS Certified Solutions Architect – Associate",
    image: "/images/badges/aws-certified-solutions-architect-associate.png",
    href: "https://cp.certmetrics.com/amazon/en/public/verify/credential/PE5WYGBB3NFQQ0W8",
    status: "Expired",
    expired: true,
  },
];

const speakingEngagements = [
  {
    conference: "POSADEV 2026",
    conferenceUrl: "https://posadev.org/",
    date: "2026-11-28",
    dateLabel: "November 28, 2026",
    location: "Guadalajara, Mexico",
    title: "Password123! – How Did We Get Here?",
    type: "Conference talk",
  },
];

const languages = ["English", "Russian", "Spanish (conversational)"];

const socialLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/vladimir-govorukhin-725232219/",
    icon: LinkedInIcon,
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/profile.php?id=100015060168023",
    icon: FacebookIcon,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/mr_govor",
    icon: InstagramIcon,
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vladimir Govorukhin",
  url: "https://vladimir.govorukhin.net/",
  image: "https://vladimir.govorukhin.net/images/profile.jpeg",
  jobTitle: "Senior DevOps / Platform Engineer",
  worksFor: {
    "@type": "Organization",
    name: "EPAM Systems",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guadalajara",
    addressCountry: "MX",
  },
  sameAs: socialLinks.map(({ href }) => href),
};
---

<Layout
  title="Vladimir Govorukhin | Senior DevOps & Platform Engineer"
  description="Vladimir Govorukhin is a Senior DevOps and Platform Engineer based in Guadalajara, Mexico, specializing in cloud infrastructure, Kubernetes, AWS, automation, and security."
  structuredData={personSchema}
>
  <main class="page-shell">
    <header class="hero" aria-labelledby="page-title">
      <div class="portrait-frame">
        <img
          src="/images/profile.jpeg"
          alt="Portrait of Vladimir Govorukhin"
          width="800"
          height="800"
          class="portrait"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="hero-copy">
        <h1 id="page-title" class="hero-name">Vladimir Govorukhin</h1>
        <p class="hero-role">Senior DevOps / Platform Engineer</p>
        <p class="hero-company">EPAM Systems</p>
        <p class="hero-summary">
          Building reliable cloud infrastructure and scalable platforms, with a
          focus on automation, Kubernetes, AWS, and security.
        </p>
        <p class="hero-tagline">Automation first. Security always.</p>
        <p class="hero-location">
          <LocationIcon class="size-4" />
          <span>Guadalajara, Mexico</span>
        </p>
      </div>
    </header>

    <div class="profile-surface">
      <section class="section-block section-block-first" aria-labelledby="contact-title">
        <div class="section-heading">
          <ContactIcon class="section-icon" />
          <div>
            <h2 id="contact-title">Contact</h2>
            <p>Direct ways to get in touch.</p>
          </div>
        </div>

        <div class="contact-grid">
          {
            contacts.map((contact) => {
              const Icon = contact.icon;
              return (
                <div class="contact-item">
                  <a
                    href={contact.href}
                    class="contact-link"
                    target={contact.external ? "_blank" : undefined}
                    rel={contact.external ? "noopener noreferrer" : undefined}
                  >
                    <span class="contact-icon-wrap" aria-hidden="true">
                      <Icon class="size-5" />
                    </span>
                    <span class="contact-copy">
                      <span class="contact-label">{contact.label}</span>
                      <span class="contact-value">{contact.value}</span>
                    </span>
                  </a>
                  <button
                    type="button"
                    class="copy-button"
                    data-copy-value={contact.copyValue}
                    data-copy-label={contact.copyLabel}
                    aria-label={`Copy ${contact.copyLabel}`}
                  >
                    <CopyIcon class="copy-icon size-4" />
                    <CheckIcon class="check-icon hidden size-4" />
                    <span class="copy-button-label">Copy</span>
                  </button>
                </div>
              );
            })
          }
        </div>
        <p id="copy-status" class="sr-only" aria-live="polite"></p>
      </section>

      <section class="section-block" aria-labelledby="speaking-title">
        <div class="section-heading">
          <SpeakingIcon class="section-icon" />
          <div>
            <h2 id="speaking-title">Speaking</h2>
            <p>Conference talks and community events.</p>
          </div>
        </div>

        <div class="speaking-list">
          {
            speakingEngagements.map((event) => (
              <article class="speaking-card" data-event-date={event.date}>
                <div class="event-topline">
                  <span class="event-status" data-event-status>Upcoming</span>
                  <a class="event-name" href={event.conferenceUrl}>
                    {event.conference}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <p class="event-meta">
                  <time datetime={event.date}>{event.dateLabel}</time>
                  <span aria-hidden="true">·</span>
                  <span>{event.location}</span>
                </p>
                <h3>{event.title}</h3>
                <p class="event-type">{event.type}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-block" aria-labelledby="certifications-title">
        <div class="section-heading">
          <CertificationIcon class="section-icon" />
          <div>
            <h2 id="certifications-title">Certifications</h2>
            <p>AWS credentials and their current status.</p>
          </div>
        </div>

        <div class="certification-grid">
          {
            certifications.map((certification) => (
              <a
                href={certification.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "certification-card",
                  { "certification-card-expired": certification.expired },
                ]}
                aria-label={`${certification.name}, ${certification.status}. Open verification page`}
              >
                <img
                  src={certification.image}
                  alt=""
                  width="600"
                  height="600"
                  class="certification-badge"
                  loading="lazy"
                  decoding="async"
                />
                <span class="certification-details">
                  <span class="certification-name">{certification.name}</span>
                  <span
                    class:list={[
                      "certification-status",
                      { "certification-status-expired": certification.expired },
                    ]}
                  >
                    <span class="status-dot" aria-hidden="true"></span>
                    {certification.status}
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="details-grid section-block">
        <section aria-labelledby="languages-title">
          <div class="section-heading section-heading-compact">
            <LanguagesIcon class="section-icon" />
            <div>
              <h2 id="languages-title">Languages</h2>
              <p>Working and conversational proficiency.</p>
            </div>
          </div>
          <ul class="language-list" aria-label="Languages spoken">
            {languages.map((language) => <li>{language}</li>)}
          </ul>
        </section>

        <section aria-labelledby="social-title">
          <div class="section-heading section-heading-compact">
            <LinkIcon class="section-icon" />
            <div>
              <h2 id="social-title">Connect</h2>
              <p>Professional and social profiles.</p>
            </div>
          </div>
          <div class="social-list">
            {
              socialLinks.map((social) => {
                const Icon = social.icon;
                return (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                  >
                    <Icon class="size-5" />
                    <span>{social.label}</span>
                  </a>
                );
              })
            }
          </div>
        </section>
      </div>
    </div>

    <footer class="site-footer">
      <p>© {currentYear} Vladimir Govorukhin</p>
      <p>Built with Astro and Tailwind CSS</p>
    </footer>
  </main>

  <script>
    const copyStatus = document.querySelector("#copy-status");

    async function copyValue(value: string) {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
        return;
      }

      const textArea = document.createElement("textarea");
      textArea.value = value;
      textArea.setAttribute("readonly", "");
      textArea.style.position = "fixed";
      textArea.style.opacity = "0";
      document.body.appendChild(textArea);
      textArea.select();
      const copied = document.execCommand("copy");
      textArea.remove();

      if (!copied) throw new Error("Copy command failed");
    }

    document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copyValue;
        const label = button.dataset.copyLabel ?? "value";
        if (!value) return;

        const buttonLabel = button.querySelector<HTMLElement>(".copy-button-label");
        const copyIcon = button.querySelector<HTMLElement>(".copy-icon");
        const checkIcon = button.querySelector<HTMLElement>(".check-icon");

        try {
          await copyValue(value);
          buttonLabel?.replaceChildren("Copied!");
          copyIcon?.classList.add("hidden");
          checkIcon?.classList.remove("hidden");
          button.dataset.state = "success";
          if (copyStatus) copyStatus.textContent = `${label} copied to clipboard.`;
        } catch (error) {
          console.error("Unable to copy value", error);
          buttonLabel?.replaceChildren("Try again");
          if (copyStatus) copyStatus.textContent = `Unable to copy ${label}.`;
        }

        window.setTimeout(() => {
          buttonLabel?.replaceChildren("Copy");
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
          delete button.dataset.state;
        }, 2000);
      });
    });

    const guadalajaraDateParts = new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Mexico_City",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
      .formatToParts(new Date())
      .reduce<Record<string, string>>((parts, { type, value }) => {
        if (type !== "literal") parts[type] = value;
        return parts;
      }, {});
    const guadalajaraDate = `${guadalajaraDateParts.year}-${guadalajaraDateParts.month}-${guadalajaraDateParts.day}`;

    document.querySelectorAll<HTMLElement>("[data-event-date]").forEach((event) => {
      const eventDate = event.dataset.eventDate;
      const status = event.querySelector<HTMLElement>("[data-event-status]");
      if (eventDate && status && guadalajaraDate >= eventDate) status.remove();
    });
  </script>
</Layout>
